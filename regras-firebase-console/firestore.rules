rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só lê e escreve o próprio documento de tipo de conta.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Dados da empresa: só a própria empresa edita.
    // Qualquer pessoa logada pode LER (o entregador precisa ver o
    // nome da empresa que aparece dentro de uma entrega).
    match /empresas/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Dados do entregador: só o próprio entregador edita os dados
    // do cadastro. Qualquer pessoa logada pode ler (a empresa
    // precisa ver o nome do entregador que aceitou a corrida).
    match /entregadores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Exceção: depois de uma entrega concluída, a EMPRESA que
      // avaliou precisa atualizar a média do entregador. Só deixa
      // mexer nesses dois campos, em nenhum outro.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['avaliacaoMedia', 'avaliacoesTotal']);
    }

    match /entregas/{entregaId} {

      // Só a própria empresa cria uma entrega em nome dela.
      allow create: if request.auth != null
                    && request.resource.data.empresaId == request.auth.uid;

      // Leitura: a empresa dona, o entregador que já aceitou, OU
      // qualquer entregador logado enquanto ela ainda está "solicitada"
      // (precisa disso pra aparecer na lista de novas solicitações).
      allow read: if request.auth != null && (
                    resource.data.empresaId == request.auth.uid ||
                    resource.data.entregadorId == request.auth.uid ||
                    resource.data.status == "solicitada"
                  );

      // Atualização:
      //  - um entregador aceitando uma entrega ainda livre;
      //  - o entregador dono atualizando o status da corrida dele;
      //  - a empresa dona avaliando uma entrega já concluída.
      allow update: if request.auth != null && (
                    (resource.data.status == "solicitada"
                     && request.resource.data.entregadorId == request.auth.uid) ||
                    resource.data.entregadorId == request.auth.uid ||
                    (resource.data.empresaId == request.auth.uid
                     && resource.data.status == "entregue")
                  );

      allow delete: if false;
    }
  }
}

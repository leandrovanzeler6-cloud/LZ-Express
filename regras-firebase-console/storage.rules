rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto da fachada da empresa: só a própria empresa envia,
    // qualquer pessoa logada pode ver.
    match /empresas/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Foto do rosto do entregador: mesma regra.
    match /entregadores/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
